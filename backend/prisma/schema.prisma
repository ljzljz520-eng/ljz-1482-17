generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum TemplateMode {
  PINNED
  FOLLOW_LATEST
}

enum MembershipStatus {
  ACTIVE
  LEFT
}

enum ProjectStatus {
  ACTIVE
  DELETED
}

enum TaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum ReservationKind {
  CREDIT
  RESERVE
  CONSUME
  RELEASE
  COMPENSATE
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  cursors      ProjectCursor[]
  favorites    TemplateFavorite[]
  attempts     TaskAttempt[]
}

model Tenant {
  id          String       @id @default(uuid())
  name        String
  balance     Int          @default(0)
  storageUsed Int          @default(0)
  storageQuota Int         @default(5000000)
  createdAt   DateTime     @default(now())
  memberships Membership[]
  projects    Project[]
  templates   Template[]
  ledger      LedgerEntry[]
  tasks       ExportTask[]
}

model Membership {
  id        String           @id @default(uuid())
  userId    String
  tenantId  String
  role      Role             @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  leftAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id])
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  @@unique([userId, tenantId])
  @@index([tenantId, status])
}

model Template {
  id           String            @id @default(uuid())
  tenantId     String
  name         String
  description  String
  isDeleted    Boolean           @default(false)
  currentVersion Int             @default(1)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  versions     TemplateVersion[]
  favorites    TemplateFavorite[]
  projects     Project[]
  @@index([tenantId, isDeleted])
}

model TemplateVersion {
  id          String             @id @default(uuid())
  templateId  String
  version     Int
  body         String
  changeNote  String
  createdAt   DateTime           @default(now())
  template    Template           @relation(fields: [templateId], references: [id])
  favorites   TemplateFavorite[]
  projects    Project[]
  @@unique([templateId, version])
}

model TemplateFavorite {
  id           String       @id @default(uuid())
  userId       String
  templateId   String
  versionId    String?
  mode         TemplateMode @default(PINNED)
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id])
  template     Template     @relation(fields: [templateId], references: [id])
  version      TemplateVersion? @relation(fields: [versionId], references: [id])
  @@unique([userId, templateId])
}

model Project {
  id               String         @id @default(uuid())
  tenantId         String
  name             String
  sourceTemplateId String?
  sourceVersionId  String?
  sourceSnapshot   String?
  status           ProjectStatus  @default(ACTIVE)
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  sourceTemplate   Template?      @relation(fields: [sourceTemplateId], references: [id])
  sourceVersion    TemplateVersion? @relation(fields: [sourceVersionId], references: [id])
  cursors          ProjectCursor[]
  tasks            ExportTask[]
  @@index([tenantId, status])
}

model ProjectCursor {
  id         String   @id @default(uuid())
  projectId  String
  userId     String
  deviceId   String
  data       String
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  @@unique([projectId, userId, deviceId])
  @@index([userId, projectId])
}

model ExportTask {
  id                 String        @id @default(uuid())
  tenantId           String
  projectId          String
  createdByUserId    String
  idempotencyKey     String
  status             TaskStatus    @default(PENDING)
  requestedUnits     Int
  estimatedUnits     Int
  actualUnits        Int?
  reservedUnits      Int           @default(0)
  failureMode        String?
  artifactName       String?
  artifactSize       Int?
  leaseToken         Int           @default(0)
  leasedBy           String?
  leasedAt           DateTime?
  leaseExpiresAt     DateTime?
  finalizedAt        DateTime?
  cancelRequestedAt  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  project            Project       @relation(fields: [projectId], references: [id])
  ledger             LedgerEntry[]
  attempts           TaskAttempt[]
  artifacts          ExportArtifact[]
  @@unique([tenantId, projectId, idempotencyKey])
  @@index([tenantId, status])
  @@index([status, leaseExpiresAt])
}

model ExportArtifact {
  id          String     @id @default(uuid())
  taskId      String
  tenantId    String
  fileName    String
  sizeBytes   Int
  mimeType    String
  content     String
  createdAt   DateTime   @default(now())
  task        ExportTask @relation(fields: [taskId], references: [id])
  @@index([tenantId, createdAt])
}

model LedgerEntry {
  id          String           @id @default(uuid())
  tenantId    String
  taskId      String?
  kind        ReservationKind
  units            Int
  amount           Int
  reservationDelta Int @default(0)
  storageDelta     Int @default(0)
  balanceAfter     Int
  note             String
  createdAt   DateTime         @default(now())
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  task        ExportTask?      @relation(fields: [taskId], references: [id])
  @@index([tenantId, createdAt])
  @@index([taskId])
}

model TaskAttempt {
  id           String      @id @default(uuid())
  taskId       String
  workerId     String
  fenceVersion Int
  startedAt    DateTime    @default(now())
  endedAt      DateTime?
  outcome      String?
  user         User?       @relation(fields: [workerId], references: [id])
  task         ExportTask  @relation(fields: [taskId], references: [id])
  @@index([taskId])
}
